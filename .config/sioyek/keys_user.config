next_page            J
previous_page        K

fit_to_page_width s
fit_to_page_height =
fit_to_page_height_smart a
toggle_dark_mode i

# I don't want q to close all windows (which it does by default)
close_window q

# forward and backward in the jump list
prev_state <C-o>
next_state <C-i>


# Makes printing easier
_open_in_zathura <C-z>
